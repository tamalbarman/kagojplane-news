---
import type { CollectionEntry } from 'astro:content';
import NewsCard from './NewsCard.astro';
import { CATEGORY_LIST } from '../utils/categories';

export interface Props {
  trendingNews: CollectionEntry<'news'>[];
}

const { trendingNews } = Astro.props;
---

<aside class="space-y-8">
  
  <!-- Hill Weather & Travel Advisory Widget -->
  <div class="bg-gradient-to-br from-emerald-950 via-[#1E3A2B] to-slate-900 rounded-xl p-5 text-white shadow-sm border border-emerald-800/60">
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-emerald-800/80">
      <h3 class="font-bold text-base flex items-center space-x-2 text-amber-300">
        <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"></path>
        </svg>
        <span>পাহাড়ে লাইভ আবহাওয়া ও রুট</span>
      </h3>
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-400 text-slate-950">
        LIVE
      </span>
    </div>

    <!-- Weather Matrix -->
    <div class="grid grid-cols-2 gap-2 mb-4 text-xs" id="sidebar-weather-grid">
      <div class="bg-black/25 rounded-lg p-2.5 border border-emerald-700/40">
        <div class="flex items-center justify-between">
          <span class="text-slate-300">দার্জিলিং</span>
          <span id="sb-icon-0">⛅</span>
        </div>
        <div class="mt-1 flex items-baseline justify-between">
          <span class="text-lg font-extrabold text-amber-300" id="sb-temp-0">১৫°C</span>
          <span class="text-[10px] text-emerald-200">কুয়াশা</span>
        </div>
      </div>

      <div class="bg-black/25 rounded-lg p-2.5 border border-emerald-700/40">
        <div class="flex items-center justify-between">
          <span class="text-slate-300">গ্যাংটক</span>
          <span id="sb-icon-1">☀️</span>
        </div>
        <div class="mt-1 flex items-baseline justify-between">
          <span class="text-lg font-extrabold text-amber-300" id="sb-temp-1">১৭°C</span>
          <span class="text-[10px] text-emerald-200">পরিষ্কার</span>
        </div>
      </div>

      <div class="bg-black/25 rounded-lg p-2.5 border border-emerald-700/40">
        <div class="flex items-center justify-between">
          <span class="text-slate-300">কালিম্পং</span>
          <span id="sb-icon-2">⛅</span>
        </div>
        <div class="mt-1 flex items-baseline justify-between">
          <span class="text-lg font-extrabold text-amber-300" id="sb-temp-2">২০°C</span>
          <span class="text-[10px] text-emerald-200">স্বাভাবিক</span>
        </div>
      </div>

      <div class="bg-black/25 rounded-lg p-2.5 border border-emerald-700/40">
        <div class="flex items-center justify-between">
          <span class="text-slate-300">শিলিগুড়ি</span>
          <span id="sb-icon-3">☀️</span>
        </div>
        <div class="mt-1 flex items-baseline justify-between">
          <span class="text-lg font-extrabold text-amber-300" id="sb-temp-3">২৪°C</span>
          <span class="text-[10px] text-emerald-200">রোদ</span>
        </div>
      </div>
    </div>

    <!-- Hill Road Status Alert -->
    <div class="bg-emerald-900/60 rounded-lg p-3 border border-emerald-700/60 text-xs space-y-1.5">
      <div class="flex items-center space-x-1.5 text-amber-300 font-semibold">
        <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <span>পাহাড়ি সড়ক আপডেট (Road Advisory):</span>
      </div>
      <p class="text-[11px] text-slate-200 leading-snug">
        • <strong>NH-10 (তিস্তাবাজার):</strong> যানবাহন চলাচল স্বাভাবিক।<br/>
        • <strong>দার্জিলিং (রোহিণী/পাঙ্খাবাড়ি):</strong> কোনো ধস নেই, পথ সচল।
      </p>
    </div>

    <a 
      href="/category/travel/" 
      class="mt-3 block text-center text-xs font-bold text-amber-300 hover:text-white transition bg-white/10 hover:bg-white/20 py-2 rounded-lg"
    >
      সম্পূর্ণ ভ্রমণ ও আবহাওয়া সতর্কতা পড়ুন &rarr;
    </a>
  </div>

  <!-- Market Watch Widget -->
  <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs">
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
      <h3 class="font-bold text-slate-900 text-base flex items-center space-x-2">
        <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
        </svg>
        <span>বাজারের এক নজর (Market Watch)</span>
      </h3>
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
    </div>
    
    <div class="space-y-3 text-sm">
      <div class="flex items-center justify-between py-1 border-b border-slate-50">
        <div>
          <span class="font-bold text-slate-800">BSE Sensex</span>
          <p class="text-[10px] text-slate-400">মুম্বাই স্টক এক্সচেঞ্জ</p>
        </div>
        <div class="text-right">
          <span class="font-bold text-red-600">৮২,৪৩৫.৫০</span>
          <p class="text-[10px] text-red-500 font-semibold">-৩২০.০০ (-০.৩৯%)</p>
        </div>
      </div>

      <div class="flex items-center justify-between py-1 border-b border-slate-50">
        <div>
          <span class="font-bold text-slate-800">NSE Nifty 50</span>
          <p class="text-[10px] text-slate-400">ন্যাশনাল স্টক এক্সচেঞ্জ</p>
        </div>
        <div class="text-right">
          <span class="font-bold text-red-600">২৫,৩৫০.২০</span>
          <p class="text-[10px] text-red-500 font-semibold">-৮৫.০০ (-০.৩৩%)</p>
        </div>
      </div>

      <div class="flex items-center justify-between py-1 border-b border-slate-50">
        <div>
          <span class="font-bold text-slate-800">সোনার দর (২৪ ক্যারাট)</span>
          <p class="text-[10px] text-slate-400">প্রতি ১০ গ্রাম (কলকাতা স্পট)</p>
        </div>
        <div class="text-right">
          <span class="font-bold text-amber-700">₹১,২৬,৫৬০</span>
          <p class="text-[10px] text-emerald-600 font-semibold">+₹৪৫০</p>
        </div>
      </div>

      <div class="flex items-center justify-between py-1">
        <div>
          <span class="font-bold text-slate-800">ডলার বনাম টাকা</span>
          <p class="text-[10px] text-slate-400">USD to INR</p>
        </div>
        <div class="text-right">
          <span class="font-bold text-slate-700">₹৮৮.৪৫</span>
          <p class="text-[10px] text-emerald-600 font-semibold">+০.১৫</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Trending / Popular Stories -->
  <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs">
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
      <h3 class="font-bold text-slate-900 text-base flex items-center space-x-2">
        <span class="w-2.5 h-2.5 bg-emerald-700 rounded-full"></span>
        <span>সর্বাধিক পঠিত খবর</span>
      </h3>
    </div>
    
    <div class="space-y-1">
      {trendingNews.slice(0, 5).map((news) => (
        <NewsCard news={news} variant="compact" />
      ))}
    </div>
  </div>

  <!-- Categories Pill Cloud -->
  <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs">
    <h3 class="font-bold text-slate-900 text-base pb-3 mb-3 border-b border-slate-100">
      ক্যাটাগরি বাছুন
    </h3>
    <div class="flex flex-wrap gap-2">
      {CATEGORY_LIST.map((cat) => (
        <a 
          href={`/category/${cat.slug}/`}
          class="text-xs font-medium px-3 py-1.5 rounded-full bg-slate-100 hover:bg-emerald-800 hover:text-white text-slate-700 transition"
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>

  <!-- WhatsApp & Community Channel Card -->
  <div class="bg-gradient-to-br from-[#121F17] to-emerald-950 text-white rounded-xl p-6 shadow-md border border-emerald-800/60">
    <div class="flex items-center space-x-3 mb-3">
      <div class="w-10 h-10 bg-emerald-500 rounded-lg flex items-center justify-center text-white shrink-0 shadow-sm">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
        </svg>
      </div>
      <div>
        <h4 class="font-bold text-base text-amber-300">WhatsApp চ্যানেলে যুক্ত হন</h4>
        <p class="text-[11px] text-emerald-200">সরাসরি মোবাইলে তাজা খবর পান</p>
      </div>
    </div>
    <p class="text-xs text-slate-300 mb-4 leading-relaxed">
      পাহাড়ে ট্রাভেল সতর্কতা, আবহাওয়া এবং রবিবারের স্পেশাল রেসিপির আপডেট সবার আগে পেতে আমাদের চ্যানেলে যুক্ত থাকুন।
    </p>
    <a 
      href="https://whatsapp.com/channel/example" 
      target="_blank" 
      rel="noopener noreferrer"
      class="block text-center w-full bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold text-xs py-2.5 rounded-lg shadow-sm transition"
    >
      হোয়াটসঅ্যাপ চ্যানেল ফলো করুন
    </a>
  </div>

  <!-- Ad Space Placeholder (AdSense Ready) -->
  <div class="bg-slate-100 border border-dashed border-slate-300 rounded-xl p-6 text-center text-xs text-slate-400">
    <span class="block font-semibold uppercase tracking-wider mb-1">বিজ্ঞাপন স্থান (Ad Space)</span>
    <span>Google AdSense / ব্যানার বিজ্ঞাপনের জায়গা</span>
  </div>

</aside>

<script is:inline>
  (function initSidebarWeather() {
    const CITIES = [
      { id: 0, lat: 27.0410, lon: 88.2663 }, // Darjeeling
      { id: 1, lat: 27.3389, lon: 88.6065 }, // Gangtok
      { id: 2, lat: 27.0594, lon: 88.4695 }, // Kalimpong
      { id: 3, lat: 26.7271, lon: 88.3953 }  // Siliguri
    ];

    function getWeatherIcon(code) {
      if (code === 0) return '☀️';
      if ([1, 2].includes(code)) return '⛅';
      if (code === 3) return '☁️';
      if ([45, 48].includes(code)) return '🌫️';
      if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return '🌧️';
      if ([71, 73, 75, 77, 85, 86].includes(code)) return '🌨️';
      if ([95, 96, 99].includes(code)) return '⛈️';
      return '⛅';
    }

    function toBengaliNum(num) {
      return Math.round(num).toString().replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[d]);
    }

    const lats = CITIES.map(c => c.lat).join(',');
    const lons = CITIES.map(c => c.lon).join(',');
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${lats}&longitude=${lons}&current=temperature_2m,weather_code&timezone=Asia%2FKolkata`;

    fetch(url)
      .then(res => res.json())
      .then(data => {
        const list = Array.isArray(data) ? data : [data];
        list.forEach((item, i) => {
          if (item && item.current) {
            const tempEl = document.getElementById(`sb-temp-${i}`);
            const iconEl = document.getElementById(`sb-icon-${i}`);
            if (tempEl) tempEl.textContent = `${toBengaliNum(item.current.temperature_2m)}°C`;
            if (iconEl) iconEl.textContent = getWeatherIcon(item.current.weather_code);
          }
        });
      })
      .catch(() => {});
  })();
</script>
