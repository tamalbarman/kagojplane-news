---
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const breakingNews = allNews
  .filter(post => post.data.breaking || post.data.trending)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);

// Bengali Date formatting
const now = new Date();
const days = ['রবিবার', 'সোমবার', 'মঙ্গলবার', 'বুধবার', 'বৃহস্পতিবার', 'শুক্রবার', 'শনিবার'];
const months = ['জানুয়ারি', 'ফেব্রুয়ারি', 'মার্চ', 'এপ্রিল', 'মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর', 'নভেম্বর', 'ডিসেম্বর'];

const bengaliDigits = (num: number | string) => {
  return num.toString().replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[parseInt(d)]);
};

const dayName = days[now.getDay()];
const dateNum = bengaliDigits(now.getDate());
const monthName = months[now.getMonth()];
const yearNum = bengaliDigits(now.getFullYear());
const formattedDate = `${dayName}, ${dateNum} ${monthName}, ${yearNum}`;
---

<div class="bg-slate-900 text-slate-300 text-xs sm:text-sm border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-9">
    
    <!-- Breaking News Ticker -->
    <div class="flex items-center space-x-2 sm:space-x-3 overflow-hidden flex-1 min-w-0 mr-2 sm:mr-4">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-500 text-slate-950 uppercase tracking-wider shrink-0 animate-pulse">
        ব্রেকিং নিউজ
      </span>
      <div class="overflow-hidden whitespace-nowrap relative w-full">
        <div class="animate-ticker inline-flex items-center space-x-8">
          {breakingNews.map((news) => (
            <a href={`/news/${news.id}/`} class="hover:text-amber-300 transition-colors flex items-center space-x-2">
              <span class="text-amber-400 font-bold">•</span>
              <span>{news.data.title}</span>
            </a>
          ))}
          {breakingNews.map((news) => (
            <a href={`/news/${news.id}/`} class="hover:text-amber-300 transition-colors flex items-center space-x-2">
              <span class="text-amber-400 font-bold">•</span>
              <span>{news.data.title}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Date & Live Weather Indicator -->
    <div class="hidden md:flex items-center space-x-3 shrink-0 text-slate-400">
      <span class="flex items-center space-x-1 text-xs">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span>{formattedDate}</span>
      </span>

      <!-- Live Weather Pill with Interactive Dropdown -->
      <span class="text-slate-600">|</span>
      <div class="relative">
        <button 
          type="button"
          id="topbar-weather" 
          class="flex items-center space-x-1.5 bg-emerald-950/80 border border-emerald-800/80 text-amber-300 text-xs px-2.5 py-0.5 rounded-full cursor-pointer hover:bg-emerald-900 transition focus:outline-none" 
          title="পাহাড়ে লাইভ আবহাওয়া (ক্লিক করে সব শহরের তালিকা দেখুন)"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
          <span id="tb-weather-icon">⛅</span>
          <span id="tb-weather-city" class="text-slate-300">দার্জিলিং:</span>
          <span id="tb-weather-temp" class="font-bold text-amber-400">১৫°C</span>
          <svg class="w-2.5 h-2.5 text-amber-400/80 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Dropdown Card (Shows all cities simultaneously) -->
        <div 
          id="weather-dropdown" 
          class="hidden absolute right-0 mt-2 w-64 bg-slate-900/95 backdrop-blur-md border border-emerald-800/80 rounded-xl shadow-2xl p-3 z-50 text-xs text-white"
        >
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-emerald-800/60">
            <span class="font-bold text-amber-300 flex items-center space-x-1">
              <span>🌦️</span>
              <span>পাহাড়ে লাইভ আবহাওয়া</span>
            </span>
            <span class="text-[10px] text-emerald-400 bg-emerald-950 px-1.5 py-0.5 rounded border border-emerald-700/60 font-semibold">
              রিয়েলটাইম
            </span>
          </div>

          <div class="space-y-1.5" id="weather-dropdown-list">
            <!-- Dynamically populated -->
          </div>

          <div class="mt-2.5 pt-2 border-t border-slate-800 text-[11px] text-center">
            <a href="/category/travel/" class="text-amber-400 hover:text-amber-300 font-semibold transition block">
              রোড ও ভ্রমণ সতর্কতা পড়ুন &rarr;
            </a>
          </div>
        </div>
      </div>

      <span class="text-slate-600">|</span>
      <a href="/admin/" class="text-amber-400 hover:text-amber-300 font-medium transition-colors flex items-center space-x-1 text-xs">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>পোস্ট করুন (/admin)</span>
      </a>
    </div>

  </div>
</div>

<script is:inline>
  (function initLiveWeather() {
    const CITIES = [
      { name: 'দার্জিলিং', desc: 'কুয়াশাচ্ছন্ন পাহাড়ি শহর', lat: 27.0410, lon: 88.2663, defaultTemp: '১৫°C', defaultIcon: '⛅' },
      { name: 'গ্যাংটক', desc: 'স্বাভাবিক ঠাণ্ডা ও মনোরম', lat: 27.3389, lon: 88.6065, defaultTemp: '১৭°C', defaultIcon: '☀️' },
      { name: 'কালিম্পং', desc: 'স্বাভাবিক পাহাড়ি আবহাওয়া', lat: 27.0594, lon: 88.4695, defaultTemp: '২০°C', defaultIcon: '⛅' },
      { name: 'শিলিগুড়ি', desc: 'তরাই ও ডুয়ার্স প্রবেশদ্বার', lat: 26.7271, lon: 88.3953, defaultTemp: '২৪°C', defaultIcon: '☀️' },
      { name: 'কলকাতা', desc: 'দক্ষিণবঙ্গের রাজধানী', lat: 22.5726, lon: 88.3639, defaultTemp: '২৭°C', defaultIcon: '☀️' }
    ];

    function getWeatherIcon(code) {
      if (code === 0) return '☀️';
      if ([1, 2].includes(code)) return '⛅';
      if (code === 3) return '☁️';
      if ([45, 48].includes(code)) return '🌫️';
      if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return '🌧️';
      if ([71, 73, 75, 77, 85, 86].includes(code)) return '🌨️';
      if ([95, 96, 99].includes(code)) return '⛈️';
      return '⛅';
    }

    function toBengaliNum(num) {
      return Math.round(num).toString().replace(/\d/g, d => '০১২৩৪৫৬৭৮৯'[d]);
    }

    let currentIndex = 0;
    let isDropdownOpen = false;
    let isUserLocked = false;
    const cityEl = document.getElementById('tb-weather-city');
    const tempEl = document.getElementById('tb-weather-temp');
    const iconEl = document.getElementById('tb-weather-icon');
    const pill = document.getElementById('topbar-weather');
    const dropdown = document.getElementById('weather-dropdown');
    const dropdownList = document.getElementById('weather-dropdown-list');

    function updateDisplay(index) {
      if (!cityEl || !tempEl || !iconEl) return;
      const c = CITIES[index];
      cityEl.textContent = `${c.name}:`;
      tempEl.textContent = c.temp || c.defaultTemp;
      iconEl.textContent = c.icon || c.defaultIcon;
    }

    function renderDropdown() {
      if (!dropdownList) return;
      dropdownList.innerHTML = CITIES.map((c, i) => `
        <button type="button" data-index="${i}" class="city-select-btn w-full flex items-center justify-between p-1.5 rounded-lg hover:bg-emerald-950/80 transition text-left group ${i === currentIndex ? 'bg-emerald-950/90 ring-1 ring-amber-400/50' : ''}">
          <div class="flex items-center space-x-2">
            <span class="text-base">${c.icon || c.defaultIcon}</span>
            <div>
              <span class="font-bold text-slate-100 group-hover:text-amber-300 transition">${c.name}</span>
              <p class="text-[9px] text-slate-400">${c.desc}</p>
            </div>
          </div>
          <span class="font-extrabold text-amber-400 text-sm">${c.temp || c.defaultTemp}</span>
        </button>
      `).join('');

      dropdownList.querySelectorAll('.city-select-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
          currentIndex = idx;
          isUserLocked = true;
          updateDisplay(currentIndex);
          toggleDropdown(false);
        });
      });
    }

    function toggleDropdown(show) {
      if (!dropdown) return;
      isDropdownOpen = typeof show === 'boolean' ? show : !isDropdownOpen;
      if (isDropdownOpen) {
        renderDropdown();
        dropdown.classList.remove('hidden');
      } else {
        dropdown.classList.add('hidden');
      }
    }

    // Auto rotate every 4 seconds when dropdown is not open and not user locked
    setInterval(() => {
      if (!isDropdownOpen && !isUserLocked) {
        currentIndex = (currentIndex + 1) % CITIES.length;
        updateDisplay(currentIndex);
      }
    }, 4000);

    if (pill) {
      pill.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown();
      });
    }

    // Close dropdown on outside click
    document.addEventListener('click', (e) => {
      if (dropdown && !dropdown.contains(e.target) && !pill.contains(e.target)) {
        toggleDropdown(false);
      }
    });

    // Live API call in browser (Open-Meteo free endpoint)
    const lats = CITIES.map(c => c.lat).join(',');
    const lons = CITIES.map(c => c.lon).join(',');
    const url = `https://api.open-meteo.com/v1/forecast?latitude=${lats}&longitude=${lons}&current=temperature_2m,weather_code&timezone=Asia%2FKolkata`;

    fetch(url)
      .then(res => res.json())
      .then(data => {
        const list = Array.isArray(data) ? data : [data];
        list.forEach((item, i) => {
          if (CITIES[i] && item && item.current) {
            CITIES[i].temp = `${toBengaliNum(item.current.temperature_2m)}°C`;
            CITIES[i].icon = getWeatherIcon(item.current.weather_code);
          }
        });
        updateDisplay(currentIndex);
        if (isDropdownOpen) renderDropdown();
      })
      .catch(() => {});
  })();
</script>
