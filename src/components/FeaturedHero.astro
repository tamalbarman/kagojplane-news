---
import type { CollectionEntry } from 'astro:content';
import NewsCard from './NewsCard.astro';

export interface Props {
  newsList: CollectionEntry<'news'>[];
}

const { newsList } = Astro.props;

// Top story is a recent featured story (within 24h) or the latest article
const oneDayAgo = Date.now() - 24 * 60 * 60 * 1000;
const recentFeatured = newsList.find(
  n => n.data.featured && n.data.pubDate.getTime() >= oneDayAgo
);
const heroStory = recentFeatured || newsList[0];
const sideStories = newsList.filter(n => n.id !== heroStory?.id).slice(0, 4);
---

<section class="mb-10">
  <div class="flex items-center justify-between mb-4 pb-2 border-b-2 border-emerald-800">
    <div class="flex items-center space-x-2">
      <span class="w-3 h-3 bg-emerald-800 rounded-xs"></span>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
        বিশেষ গুরুত্বপূর্ণ খবর
      </h2>
    </div>
    <span class="text-xs text-slate-400 font-medium">আজকের বাছাই করা শিরোনাম</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Big Hero Feature (7 columns on large screen) -->
    {heroStory && (
      <div class="lg:col-span-7">
        <NewsCard news={heroStory} variant="featured" />
      </div>
    )}

    <!-- 4 Side Highlights (5 columns on large screen) -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-3">
      {sideStories.map((story) => (
        <NewsCard news={story} variant="horizontal" />
      ))}
    </div>
  </div>
</section>
