---
import { CATEGORY_LIST } from '../utils/categories';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 mt-16 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-10">
      
      <!-- Brand & About -->
      <div>
        <div class="flex items-center space-x-2.5 mb-3">
          <div class="w-8 h-8 bg-gradient-to-br from-red-600 to-red-700 text-white rounded-lg flex items-center justify-center shadow-xs">
            <svg class="w-4 h-4 transform -rotate-12 translate-x-0.5 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
            </svg>
          </div>
          <span class="text-xl font-extrabold text-white tracking-tight">
            দ্য <span class="text-red-500">কাগজপ্লেন</span>
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed mb-4">
          ভারতীয় ও বৈশ্বিক অর্থনীতি, শেয়ার বাজার, ব্যবসা-বাণিজ্য, স্বর্ণের দর ও সরকারি প্রকল্প সংক্রান্ত বস্তুনিষ্ঠ সংবাদের বিশ্বস্ত বাংলা মাধ্যম।
        </p>
        <div class="text-xs text-slate-400 space-y-1">
          <p><strong class="text-slate-300">ইমেল:</strong> contact@kagojplane.com</p>
          <p><strong class="text-slate-300">সম্পাদক:</strong> সুনন্দা সেন</p>
        </div>
      </div>

      <!-- Categories 1 -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          প্রধান বিভাগসমূহ
        </h4>
        <ul class="space-y-2 text-xs">
          {CATEGORY_LIST.slice(0, 5).map((cat) => (
            <li>
              <a href={`/category/${cat.slug}/`} class="hover:text-red-400 transition-colors">
                {cat.name} ({cat.englishName})
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categories 2 -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          অন্যান্য বিভাগ
        </h4>
        <ul class="space-y-2 text-xs">
          {CATEGORY_LIST.slice(5).map((cat) => (
            <li>
              <a href={`/category/${cat.slug}/`} class="hover:text-red-400 transition-colors">
                {cat.name} ({cat.englishName})
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Important Links & Admin -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          জরুরি লিঙ্ক ও পোর্টাল
        </h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li>
            <a href="/admin/" class="text-amber-400 hover:underline font-semibold flex items-center space-x-1">
              <span>&rarr;</span>
              <span>এডমিন প্যানেল (/admin)</span>
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="hover:text-red-400 transition-colors">
              আরএসএস ফিড (RSS Feed)
            </a>
          </li>
          <li>
            <a href="/about/" class="hover:text-red-400 transition-colors">আমাদের সম্পর্কে (About Us)</a>
          </li>
          <li>
            <a href="/privacy/" class="hover:text-red-400 transition-colors">গোপনীয়তা নীতি (Privacy Policy)</a>
          </li>
          <li>
            <a href="/terms/" class="hover:text-red-400 transition-colors">ব্যবহারের শর্তাবলী (Terms of Use)</a>
          </li>
          <li>
            <a href="/contact/" class="hover:text-red-400 transition-colors">যোগাযোগ (Contact Us)</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Disclaimer & Copyright -->
    <div class="pt-8 border-t border-slate-800 text-center text-xs text-slate-500 space-y-2">
      <p>
        <strong>সতর্কতা:</strong> শেয়ার বাজার ও মিউচুয়াল ফান্ড বিনিয়োগ বাজারগত ঝুঁকির সাপেক্ষ। যেকোনো আর্থিক সিদ্ধান্ত নেওয়ার আগে আপনার সার্টিফাইড আর্থিক উপদেষ্টার পরামর্শ নিন।
      </p>
      <p>
        © {currentYear} দ্য কাগজপ্লেন (The Kagojplane). সর্বস্বত্ব সংরক্ষিত। 
        হোস্টিং: Netlify (Free Jamstack CDN) | ইঞ্জিন: Astro & Decap CMS.
      </p>
    </div>

  </div>
</footer>
