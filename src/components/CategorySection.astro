---
import type { CollectionEntry } from 'astro:content';
import NewsCard from './NewsCard.astro';
import { getCategoryMeta } from '../utils/categories';

export interface Props {
  categorySlug: string;
  articles: CollectionEntry<'news'>[];
  limit?: number;
}

const { categorySlug, articles, limit = 4 } = Astro.props;
const categoryMeta = getCategoryMeta(categorySlug);
const displayArticles = articles.slice(0, limit);
---

{displayArticles.length > 0 && (
  <section class="mb-10">
    <div class="flex items-center justify-between mb-4 pb-2 border-b-2 border-slate-200">
      <div class="flex items-center space-x-2">
        <span class={`w-3.5 h-3.5 rounded-xs ${categoryMeta.bgColor}`}></span>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900">
          {categoryMeta.name}
        </h3>
      </div>
      <a 
        href={`/category/${categorySlug}/`} 
        class="text-xs font-semibold text-red-600 hover:text-red-700 flex items-center space-x-1"
      >
        <span>সব দেখুন</span>
        <span>&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {displayArticles.map((article) => (
        <NewsCard news={article} variant="standard" />
      ))}
    </div>
  </section>
)}
