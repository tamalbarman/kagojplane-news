---
---

<header class="bg-white border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    
    <!-- Logo & Brand -->
    <div class="flex items-center justify-between gap-2 min-w-0">
      <a href="/" class="flex items-center space-x-2.5 sm:space-x-3.5 group min-w-0">
        <div class="relative w-10 h-10 sm:w-14 sm:h-14 rounded-full overflow-hidden shadow-sm ring-2 ring-amber-500/30 group-hover:ring-amber-500/60 transition-all duration-300 transform group-hover:scale-105 shrink-0 bg-emerald-950">
          <img 
            src="/images/logo.png" 
            alt="দ্য কাগজপ্লেন লোগো" 
            width="56" 
            height="56" 
            class="w-full h-full object-cover" 
          />
        </div>
        <div class="min-w-0">
          <div class="flex items-center space-x-2">
            <span class="text-xl sm:text-3xl font-extrabold tracking-tight text-slate-900 group-hover:text-emerald-900 transition truncate">
              দ্য <span class="text-emerald-800">কাগজপ্লেন</span>
            </span>
          </div>
          <p class="text-[11px] sm:text-xs text-slate-500 font-medium tracking-wide leading-tight line-clamp-1">
            ভ্রমণ আপডেট, আবহাওয়া, সংবাদ ও রবিবারের রেসিপি
          </p>
        </div>
      </a>

      <!-- Mobile Right Actions -->
      <div class="flex items-center space-x-1.5 md:hidden shrink-0">
        <button id="theme-toggle-mobile" aria-label="ডার্ক মোড টগল" class="p-2 rounded-lg bg-slate-100 text-slate-700 transition" title="ডার্ক মোড">
          <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          <svg class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        </button>
        <a href="https://whatsapp.com/channel/example" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition" title="হোয়াটসঅ্যাপ চ্যানেল">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/></svg>
        </a>
        <a href="/admin/" class="text-[11px] font-semibold px-2 py-1.5 bg-emerald-50 text-emerald-800 rounded-md border border-emerald-200 whitespace-nowrap">
          পোস্ট লিখুন
        </a>
      </div>
    </div>

    <!-- Quick Market Bar & Search -->
    <div class="flex items-center justify-between md:justify-end gap-3">
      
      <!-- Mini Market Rates Bar -->
      <div class="hidden lg:flex items-center space-x-3 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs">
        <div class="flex items-center space-x-1">
          <span class="font-bold text-slate-700">Sensex:</span>
          <span class="text-red-600 font-semibold">৮২,৪৩৫ (-০.৪%)</span>
        </div>
        <span class="text-slate-300">|</span>
        <div class="flex items-center space-x-1">
          <span class="font-bold text-slate-700">Nifty:</span>
          <span class="text-red-600 font-semibold">২৫,৩৫০ (-০.৩%)</span>
        </div>
        <span class="text-slate-300">|</span>
        <div class="flex items-center space-x-1">
          <span class="font-bold text-slate-700">Gold:</span>
          <span class="text-amber-700 font-semibold">₹১,২৬,৫৬০</span>
        </div>
      </div>

      <!-- Quick Search input -->
      <form action="/" method="GET" class="relative w-full md:w-56" id="site-search-form">
        <input 
          type="text" 
          name="q"
          id="site-search-input"
          placeholder="সংবাদ খুঁজুন..." 
          class="w-full text-sm bg-slate-50 border border-slate-200 rounded-full pl-9 pr-3 py-1.5 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:bg-white transition"
        />
        <button type="submit" aria-label="খুঁজুন" class="absolute left-3 top-2.5 text-slate-400 hover:text-emerald-700 transition">
          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      </form>

      <!-- WhatsApp Channel Button (Desktop) -->
      <a 
        href="https://whatsapp.com/channel/example" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs transition shrink-0"
        title="হোয়াটসঅ্যাপ চ্যানেলে যুক্ত হন"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
        </svg>
        <span>WhatsApp চ্যানেল</span>
      </a>

      <!-- Theme Toggle (Desktop) -->
      <button 
        id="theme-toggle" 
        aria-label="ডার্ক মোড টগল" 
        class="hidden sm:inline-flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 transition shrink-0"
        title="ডার্ক / লাইট মোড পরিবর্তন করুন"
      >
        <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <svg class="w-4 h-4 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
      </button>

    </div>

  </div>
</header>

<script is:inline>
  (function initThemeToggle() {
    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    const btnDesktop = document.getElementById('theme-toggle');
    const btnMobile = document.getElementById('theme-toggle-mobile');

    if (btnDesktop) btnDesktop.addEventListener('click', toggleTheme);
    if (btnMobile) btnMobile.addEventListener('click', toggleTheme);
  })();
</script>
