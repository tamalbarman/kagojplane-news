---
---

<header class="bg-white border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    
    <!-- Logo & Brand -->
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center space-x-3.5 group">
        <div class="relative w-12 h-12 sm:w-14 sm:h-14 rounded-full overflow-hidden shadow-sm ring-2 ring-amber-500/30 group-hover:ring-amber-500/60 transition-all duration-300 transform group-hover:scale-105 shrink-0 bg-emerald-950">
          <img 
            src="/images/logo.png" 
            alt="দ্য কাগজপ্লেন লোগো" 
            width="56" 
            height="56" 
            class="w-full h-full object-cover" 
          />
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <span class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 group-hover:text-emerald-900 transition">
              দ্য <span class="text-emerald-800">কাগজপ্লেন</span>
            </span>
          </div>
          <p class="text-xs text-slate-500 font-medium tracking-wide">
            ভ্রমণ আপডেট, আবহাওয়া, সংবাদ ও রবিবারের রেসিপি
          </p>
        </div>
      </a>

      <!-- Mobile Search / Menu Toggle -->
      <div class="flex items-center space-x-2 md:hidden">
        <a href="/admin/" class="text-xs font-semibold px-2.5 py-1.5 bg-emerald-50 text-emerald-800 rounded-md border border-emerald-200">
          পোস্ট লিখুন
        </a>
      </div>
    </div>

    <!-- Quick Market Bar & Search -->
    <div class="flex items-center justify-between md:justify-end space-x-4">
      
      <!-- Mini Market Rates Bar -->
      <div class="hidden lg:flex items-center space-x-3 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs">
        <div class="flex items-center space-x-1">
          <span class="font-bold text-slate-700">Sensex:</span>
          <span class="text-red-600 font-semibold">৮২,৪৩৫ (-০.৪%)</span>
        </div>
        <span class="text-slate-300">|</span>
        <div class="flex items-center space-x-1">
          <span class="font-bold text-slate-700">Nifty:</span>
          <span class="text-red-600 font-semibold">২৫,৩৫০ (-০.৩%)</span>
        </div>
        <span class="text-slate-300">|</span>
        <div class="flex items-center space-x-1">
          <span class="font-bold text-slate-700">Gold:</span>
          <span class="text-amber-700 font-semibold">₹৭৮,২০০</span>
        </div>
      </div>

      <!-- Quick Search input -->
      <form action="/" method="GET" class="relative w-full md:w-60" id="site-search-form">
        <input 
          type="text" 
          name="q"
          id="site-search-input"
          placeholder="সংবাদ খুঁজুন..." 
          class="w-full text-sm bg-slate-50 border border-slate-200 rounded-full pl-9 pr-3 py-1.5 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:bg-white transition"
        />
        <button type="submit" aria-label="খুঁজুন" class="absolute left-3 top-2.5 text-slate-400 hover:text-emerald-700 transition">
          <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </button>
      </form>

    </div>

  </div>
</header>
