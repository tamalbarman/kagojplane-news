---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  articleDate?: Date;
  author?: string;
  category?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'দৈনন্দিন ভ্রমণ আপডেট, পাহাড়ে আবহাওয়া সতর্কতা, রবিবারের স্পেশাল রেসিপি ও সংবাদের বিশ্বস্ত পোর্টাল',
  image = '/images/og-image.jpg',
  articleDate,
  author = 'দ্য কাগজপ্লেন',
  category,
  type = 'website'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'দ্য কাগজপ্লেন (The Kagojplane)';

const schemaData = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  'headline': title,
  'description': description,
  'image': [image],
  'datePublished': articleDate ? articleDate.toISOString() : undefined,
  'dateModified': articleDate ? articleDate.toISOString() : undefined,
  'author': [{
    '@type': 'Person',
    'name': author
  }],
  'publisher': {
    '@type': 'NewsMediaOrganization',
    'name': siteName,
    'url': Astro.site ? Astro.site.toString() : 'https://thekagojplane.netlify.app',
    'logo': {
      '@type': 'ImageObject',
      'url': new URL('/images/logo.png', Astro.site || 'https://thekagojplane.netlify.app').toString()
    }
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalURL.toString()
  }
} : {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': siteName,
  'url': Astro.site ? Astro.site.toString() : 'https://thekagojplane.netlify.app',
  'potentialAction': {
    '@type': 'SearchAction',
    'target': `${Astro.site || 'https://thekagojplane.netlify.app'}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import CategoryNav from '../components/CategoryNav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
  <link rel="canonical" href={canonicalURL} />
  
  <title>{title} | {siteName}</title>
  <meta name="title" content={`${title} | ${siteName}`} />
  <meta name="description" content={description} />
  <meta name="author" content={author} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#1E3A2B" />

  <!-- Dark Mode Script (Instant apply to avoid flash) -->
  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>

  <!-- Font preconnect & PWA Manifest -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content={siteName} />
  {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
  {category && <meta property="article:section" content={category} />}

  <!-- Twitter Card -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={image} />

  <!-- RSS Feed discovery -->
  <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href="/rss.xml" />

  <!-- Netlify Identity Widget for Decap CMS admin login -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-bengali min-h-screen flex flex-col antialiased selection:bg-emerald-700 selection:text-white">
  <!-- Top ticker & live status -->
  <TopBar />

  <!-- Main Portal Header -->
  <Header />

  <!-- Category Navigation Bar -->
  <CategoryNav />

  <!-- Main Content Body -->
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <slot />
  </main>

  <!-- Portal Footer -->
  <Footer />

  <!-- Cookie Consent Banner & Settings Modal -->
  <CookieConsent />

  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
