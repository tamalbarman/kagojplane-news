---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getCategoryMeta } from '../utils/categories';

const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 8);
---

<Layout
  title="সাবস্ক্রাইব করুন - দ্য কাগজপ্লেন"
  description="দ্য কাগজপ্লেন-এর ব্রেকিং নিউজ, স্টক মার্কেট, পাহাড়ি ভ্রমণ আপডেট এবং দৈনন্দিন সংবাদ সরাসরি ইমেইলে পেতে সাবস্ক্রাইব করুন।"
>
  <div class="max-w-4xl mx-auto space-y-8">
    <!-- Hero Newsletter Subscribe Card -->
    <section class="bg-gradient-to-r from-emerald-950 via-[#1E3A2B] to-slate-900 border border-emerald-800/80 rounded-2xl p-6 sm:p-8 text-white shadow-md">
      <span class="text-xs font-bold uppercase tracking-wider bg-white/15 px-2.5 py-1 rounded text-amber-300">
        সরাসরি নিউজ আপডেট
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold mt-3 text-white">
        দ্য কাগজপ্লেন-এ সাবস্ক্রাইব করুন
      </h1>
      <p class="text-sm text-emerald-100 mt-2 leading-relaxed max-w-2xl">
        স্টক মার্কেট, টেক ও এআই, পাহাড়ি আবহাওয়া সতর্কতা এবং দৈনন্দিন গুরুত্বপূর্ণ খবর সরাসরি আপনার ইমেইলে পেতে নিচে সাবস্ক্রাইব করুন।
      </p>

      <!-- Netlify Email Subscription Form -->
      <form
        id="newsletter-form"
        name="newsletter"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-6 bg-black/30 border border-emerald-700/60 rounded-xl p-4 sm:p-5 space-y-3"
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
          <div class="sm:col-span-4">
            <label for="sub-name" class="block text-xs font-semibold text-amber-300 mb-1">
              আপনার নাম
            </label>
            <input
              id="sub-name"
              name="name"
              type="text"
              placeholder="যেমন: অনির্বাণ রায়"
              class="w-full bg-slate-950/80 text-white placeholder-slate-400 text-sm px-3.5 py-2.5 rounded-lg border border-emerald-800 focus:border-amber-400 outline-none"
            />
          </div>

          <div class="sm:col-span-5">
            <label for="sub-email" class="block text-xs font-semibold text-amber-300 mb-1">
              ইমেইল ঠিকানা <span class="text-amber-400">*</span>
            </label>
            <input
              id="sub-email"
              name="email"
              type="email"
              required
              placeholder="name@example.com"
              class="w-full bg-slate-950/80 text-white placeholder-slate-400 text-sm px-3.5 py-2.5 rounded-lg border border-emerald-800 focus:border-amber-400 outline-none"
            />
          </div>

          <div class="sm:col-span-3 flex items-end">
            <button
              id="sub-submit-btn"
              type="submit"
              class="w-full bg-amber-500 hover:bg-amber-400 disabled:opacity-60 text-slate-950 font-bold text-sm px-4 py-2.5 rounded-lg transition shadow-xs cursor-pointer"
            >
              সাবস্ক্রাইব করুন
            </button>
          </div>
        </div>

        <div id="sub-feedback" class="hidden text-xs font-semibold rounded-lg px-3.5 py-2.5"></div>
      </form>
    </section>

    <!-- Latest News Preview -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 flex items-center space-x-2">
          <span class="w-3 h-3 bg-emerald-800 rounded-xs"></span>
          <span>সর্বশেষ প্রকাশিত খবর (Latest Updates)</span>
        </h2>
        <a href="/" class="text-xs font-bold text-emerald-800 hover:underline">
          সব খবর দেখুন &rarr;
        </a>
      </div>

      <div class="divide-y divide-slate-100">
        {latestNews.map((item) => {
          const catMeta = getCategoryMeta(item.data.category);
          const dateStr = item.data.pubDate.toLocaleDateString('bn-IN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          return (
            <article class="py-3.5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
              <div class="space-y-1">
                <div class="flex items-center space-x-2 text-[11px]">
                  <span class={`text-white font-bold px-2 py-0.5 rounded ${catMeta.bgColor}`}>
                    {catMeta.name}
                  </span>
                  <span class="text-slate-400">{dateStr}</span>
                </div>
                <h3 class="font-bold text-slate-900 text-sm sm:text-base hover:text-emerald-800 transition">
                  <a href={`/news/${item.id}/`}>{item.data.title}</a>
                </h3>
              </div>
              <a
                href={`/news/${item.id}/`}
                class="text-xs font-bold text-emerald-800 hover:underline whitespace-nowrap shrink-0"
              >
                পড়ুন &rarr;
              </a>
            </article>
          );
        })}
      </div>
    </section>
  </div>

  <script is:inline>
    const form = document.getElementById('newsletter-form');
    const submitBtn = document.getElementById('sub-submit-btn');
    const feedback = document.getElementById('sub-feedback');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!feedback || !submitBtn) return;

      feedback.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'অপেক্ষা করুন...';

      try {
        const formData = new FormData(form);
        const res = await fetch('/subscribe/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData).toString(),
        });

        if (!res.ok) {
          throw new Error('সাবস্ক্রিপশন সম্পন্ন করা যায়নি।');
        }

        feedback.className = 'text-xs font-semibold rounded-lg px-3.5 py-2.5 bg-emerald-900/80 border border-emerald-500/50 text-emerald-200';
        feedback.textContent = '✅ ধন্যবাদ! আপনার ইমেইল সফলভাবে সাবস্ক্রাইব করা হয়েছে।';
        feedback.classList.remove('hidden');
        form.reset();
      } catch {
        feedback.className = 'text-xs font-semibold rounded-lg px-3.5 py-2.5 bg-red-950/80 border border-red-500/50 text-red-200';
        feedback.textContent = '⚠️ এই মুহূর্তে সাবস্ক্রিপশন সম্পন্ন করা যায়নি। লাইভ Netlify সাইটে এটি সক্রিয় থাকবে।';
        feedback.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'সাবস্ক্রাইব করুন';
      }
    });
  </script>
</Layout>
