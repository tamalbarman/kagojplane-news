---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="যোগাযোগ (Contact Us)"
  description="কাগজপ্লেন নিউজ এর সম্পাদকীয় ও বিজ্ঞাপন বিভাগের সাথে যোগাযোগ করুন।"
>
  <div class="max-w-4xl mx-auto my-6">
    
    <div class="bg-white rounded-xl p-6 sm:p-10 border border-slate-200 shadow-xs mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-2">যোগাযোগ করুন (Contact Us)</h1>
      <p class="text-slate-600 text-sm mb-6">
        যেকোনো সংবাদ সংক্রান্ত তথ্য, মতামত, সংশোধন বা বিজ্ঞাপনের জন্য সরাসরি আমাদের সাথে যোগাযোগ করুন।
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-slate-100">
        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
          <h4 class="font-bold text-slate-800 text-sm mb-1">সম্পাদকীয় বিভাগ</h4>
          <p class="text-xs text-slate-600 mb-1">সুনন্দা সেন (সম্পাদক)</p>
          <a href="mailto:editor@kagojplane.com" class="text-xs text-red-600 hover:underline">editor@kagojplane.com</a>
        </div>

        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
          <h4 class="font-bold text-slate-800 text-sm mb-1">বিজ্ঞাপন ও সহযোগিতা</h4>
          <p class="text-xs text-slate-600 mb-1">বিজ্ঞাপন প্রকাশের বিস্তারিত তথ্যের জন্য</p>
          <a href="mailto:ads@kagojplane.com" class="text-xs text-red-600 hover:underline">ads@kagojplane.com</a>
        </div>

        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
          <h4 class="font-bold text-slate-800 text-sm mb-1">টেলিগ্রাম চ্যানেল</h4>
          <p class="text-xs text-slate-600 mb-1">ব্রেকিং নিউজ লাইভ আপডেট</p>
          <a href="https://telegram.org" target="_blank" rel="noopener noreferrer" class="text-xs text-red-600 hover:underline">t.me/kagojplanenews</a>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="bg-white rounded-xl p-6 sm:p-10 border border-slate-200 shadow-xs">
      <h2 class="text-xl font-bold text-slate-900 mb-4">আমাদের একটি বার্তা পাঠান</h2>
      
      <form 
        name="contact" 
        method="POST" 
        data-netlify="true" 
        action="/contact/?success=true" 
        class="space-y-4"
      >
        <input type="hidden" name="form-name" value="contact" />
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1" for="name">আপনার নাম *</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-500" 
              placeholder="যেমন: রাহুল মুখার্জী"
            />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1" for="email">ইমেল ঠিকানা *</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-500" 
              placeholder="name@example.com"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1" for="subject">বিষয় *</label>
          <input 
            type="text" 
            id="subject" 
            name="subject" 
            required 
            class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-500" 
            placeholder="সংবাদের সংশোধন / বিজ্ঞাপন / অন্যান্য"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1" for="message">বার্তা বিবরণ *</label>
          <textarea 
            id="message" 
            name="message" 
            rows="5" 
            required 
            class="w-full text-sm bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-red-500"
            placeholder="আপনার বক্তব্য বিস্তারিত লিখুন..."
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="bg-red-600 hover:bg-red-700 text-white font-bold text-sm px-6 py-2.5 rounded-lg transition shadow-xs"
        >
          বার্তা পাঠান
        </button>
      </form>
    </div>

  </div>
</Layout>
